[Unit]
Description=Sync AI-BOT captures into sample review on server 8
After=network-online.target ai-bot-sample-review.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ai-bot-sample-review
Environment=SAMPLE_REVIEW_ROOT=/app
EnvironmentFile=/etc/ai-bot-sample-review/device.env
EnvironmentFile=-/etc/ai-bot-sample-review/oss.env
ExecStart=/usr/bin/docker run --rm --network host -v /srv/ai-bot-sample-review:/app -v /usr/local/bin/ossutil:/usr/local/bin/ossutil:ro -w /app -e SAMPLE_REVIEW_ROOT -e AI_BOT_DEVICE_SSH_USER -e AI_BOT_DEVICE_SSH_PASSWORD -e OSS_ACCESS_KEY_ID -e OSS_ACCESS_KEY_SECRET -e OSS_REGION -e OSS_ENDPOINT -e OSS_BUCKET -e OSS_PREFIX ai-bot-sample-review:20260802-150335 python /app/sync_worker.py --config /app/sync-config.json
