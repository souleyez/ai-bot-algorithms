[Unit]
Description=Apply AI-BOT sample-review OSS retention policy
After=network-online.target docker.service ai-bot-sample-review.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ai-bot-sample-review
Environment=SAMPLE_REVIEW_ROOT=/app
EnvironmentFile=-/etc/ai-bot-sample-review/oss.env
ExecStart=/usr/bin/flock -n /run/ai-bot-sample-review-retention.lock /usr/bin/docker run --rm --name ai-bot-sample-review-retention --network host -v /srv/ai-bot-sample-review:/app -v /usr/local/bin/ossutil:/usr/local/bin/ossutil:ro -w /app -e SAMPLE_REVIEW_ROOT -e OSS_ACCESS_KEY_ID -e OSS_ACCESS_KEY_SECRET -e OSS_REGION -e OSS_ENDPOINT -e OSS_BUCKET -e OSS_PREFIX -e OSS_USE_SDK ai-bot-sample-review:20260802-150335 python /app/retention_worker.py apply --root /app --retention-days 90 --limit 1000
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target

