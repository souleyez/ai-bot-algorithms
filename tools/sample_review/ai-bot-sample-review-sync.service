[Unit]
Description=Sync AI Bot captures into sample review
After=network-online.target ai-bot-sample-review.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ai-bot-sample-review
Environment=SAMPLE_REVIEW_ROOT=/srv/ai-bot-sample-review
EnvironmentFile=-/etc/ai-bot-sample-review/oss.env
ExecStart=/usr/bin/python3 /srv/ai-bot-sample-review/sync_worker.py --config /srv/ai-bot-sample-review/sync-config.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/ai-bot-sample-review/data
