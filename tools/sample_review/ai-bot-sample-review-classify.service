[Unit]
Description=Pre-label recent AI-BOT samples with MiniMax
After=network-online.target ai-bot-sample-review.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ai-bot-sample-review
Environment=SAMPLE_REVIEW_ROOT=/app
EnvironmentFile=-/etc/ai-bot-sample-review/minimax.env
EnvironmentFile=-/etc/ai-bot-sample-review/oss.env
ExecStart=/usr/bin/docker run --rm --name ai-bot-sample-review-classify --network host -v /srv/ai-bot-sample-review:/app -v /usr/local/bin/ossutil:/usr/local/bin/ossutil:ro -w /app -e SAMPLE_REVIEW_ROOT -e MINIMAX_API_KEY -e MINIMAX_BASE_URL -e MINIMAX_MODEL -e OSS_ACCESS_KEY_ID -e OSS_ACCESS_KEY_SECRET -e OSS_REGION -e OSS_ENDPOINT -e OSS_BUCKET -e OSS_PREFIX ai-bot-sample-review:20260802-150335 python /app/classify_recent_pending.py --root /app --apply --limit 12 --max-age-days 14
TimeoutStartSec=25min

