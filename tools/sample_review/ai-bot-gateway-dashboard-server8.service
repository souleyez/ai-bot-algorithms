[Unit]
Description=Collect AI-BOT gateway dashboard snapshot on server 8
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/ai-bot-sample-review/device.env
ExecStart=/usr/bin/docker run --rm --network host \
  -v /srv/ai-bot-sample-review:/app \
  -v /srv/ai-bot-algorithm-platform/devices.json:/inventory/devices.json:ro \
  -v /opt/ai-bot-sample-review/current:/opt/ai-bot-sample-review:ro \
  -e AI_BOT_DEVICE_SSH_USER -e AI_BOT_DEVICE_SSH_PASSWORD \
  ai-bot-sample-review:20260802-150335 \
  python /opt/ai-bot-sample-review/tools/sample_review/dashboard_collector.py \
  --inventory /inventory/devices.json --output /app/data/gateway-dashboard.json --workers 5

[Install]
WantedBy=multi-user.target
